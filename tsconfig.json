{
    "compilerOptions": {
      "target": "ES2022",
      "module": "CommonJS",
      "moduleResolution": "Node",
      "esModuleInterop": true,
      "strict": true,
      "skipLibCheck": true,
      "types": [
        "node",
        "@cucumber/cucumber",
        "@playwright/test"
      ]
    },
    "include": [
      "features/**/*.ts",
      "step-definitions/**/*.ts",
      "pages/**/*.ts",
      "tests/**/*.ts"
    ]
  }